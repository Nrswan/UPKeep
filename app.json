{
  "expo": {
    "name": "Upkeep",
    "slug": "upkeep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.upkeep"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F6F7A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yourname.upkeep"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "upkeep",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Upkeep uses your photos so you can attach pictures of receipts, warranties and the things you maintain.",
          "cameraPermission": "Upkeep uses the camera so you can take pictures of receipts, warranties and the things you maintain.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
