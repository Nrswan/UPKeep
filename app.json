{
  "expo": {
    "name": "Your Home-E",
    "slug": "home-e",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nickswanson.yourhomee",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F6F7A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nickswanson.yourhomee"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "homee",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Your Home-E uses your photos so you can attach pictures of receipts, warranties and the things you maintain.",
          "cameraPermission": "Your Home-E uses the camera so you can take pictures of receipts, warranties and the things you maintain.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
